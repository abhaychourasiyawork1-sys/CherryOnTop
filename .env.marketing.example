# CherryOnTop public marketing service. Copy to .env.marketing (git-ignored) and adjust.
# Never point MARKETING_DB_PATH at the runtime daemon's database.

# Listener. Keep 127.0.0.1 behind a local reverse proxy; use 0.0.0.0 only when the
# process itself is the public edge (e.g. inside a container with a mapped port).
MARKETING_PORT=4178
MARKETING_HOST=127.0.0.1

# Dedicated marketing SQLite file (waitlist + telemetry only). Default: ~/.cherryontop/marketing.db
MARKETING_DB_PATH=/var/lib/cherryontop-marketing/marketing.db

# Built static site served on the same origin as /api/*. Build with `npm run marketing:build`.
MARKETING_SITE_DIR=site/dist

# Optional. Only needed if a different origin must call the API; same-origin needs nothing.
MARKETING_ALLOWED_ORIGIN=

# "true" ONLY when a trusted reverse proxy sets X-Forwarded-For. Leave unset/false otherwise,
# or clients can spoof their rate-limit identity.
MARKETING_TRUST_PROXY=false

# If set, waitlist submissions must carry this consent version (keep in sync with
# VITE_MARKETING_CONSENT_VERSION at site build time).
MARKETING_CONSENT_VERSION=

# Optional extra CSP media-src origin when the promo video is hosted off-origin,
# e.g. https://media.example-cdn.net (must match the origin of VITE_PROMO_VIDEO_URL).
MARKETING_MEDIA_ORIGIN=

# --- Site build-time variables (read by Vite during `npm run marketing:build`) ---
# Optional promo video URL override; defaults to the bundled /media/cherryontop-promo.mp4.
VITE_PROMO_VIDEO_URL=
# Final public origin (no trailing slash), used for canonical/Open Graph/sitemap URLs.
VITE_SITE_ORIGIN=
# Consent version sent with waitlist submissions.
VITE_MARKETING_CONSENT_VERSION=
